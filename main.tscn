[sub_resource type="GDScript" id="GDScript_7mycd"]
resource_name = "buttonwork"
script/source = "extends Button


@export var player: CharacterBody2D

func _ready() -> void:
	pressed.connect(_on_button_pressed)


func _on_button_pressed() -> void:
	player.Restart()
"

[sub_resource type="GDScript" id="GDScript_1qa5v"]
resource_name = "PouseMenu"
script/source = "extends Sprite2D
"

[sub_resource type="GDScript" id="GDScript_s3gyj"]
resource_name = "OpenDifficultyMenu"
script/source = "extends MenuButton


@export var MainMenu: Sprite2D 

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass
	
func _on_button_pressed() -> void:
	MainMenu.hide()
	
	
"

