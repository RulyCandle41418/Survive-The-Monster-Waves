[sub_resource type="GDScript" id="GDScript_1qa5v"]
resource_name = "Monsterse"
script/source = "extends CharacterBody2D


const SPEED = 300.0
const JUMP_VELOCITY = -400.0

@export var player: CharacterBody2D
@export var monster: CharacterBody2D

var Done = false

func _physics_process(delta: float) -> void:
	
	
	if Input.is_action_pressed(\"Mouse_left\") && global_position.distance_to(player.global_position) < 150:
		
		global_position = Vector2(2000, 500)
		global_position = monster.global_position
		
	elif global_position.distance_to(player.global_position) < 125:
		player.take_damage(global_position)
		
		
	else:
		velocity = global_position.direction_to(player.global_position) * SPEED
		monster.set_collision_layer_value(1, true)
		monster.set_collision_mask_value(1, true)

	move_and_slide()
	
	
"

